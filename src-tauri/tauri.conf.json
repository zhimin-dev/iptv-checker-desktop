{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iptv-checker-player",
  "version": "0.1.0",
  "identifier": "com.zhimin-dev.iptv-checker-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "iptv-checker-player",
        "label": "main",
        "width": 1180,
        "height": 760,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "IPTV player client for iptv-checker server",
    "longDescription": "Jellyfin-like IPTV client: connect to an iptv-checker server, browse channels and watch live TV. Supports smooth-mode server-side buffering relay.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
